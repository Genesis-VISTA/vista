# see src/vista_collaboration_server/config.py

VISTA_COLLAB_HOST=0.0.0.0
VISTA_COLLAB_PORT=8081

# Believe only Keycloak tokens from Obsidian's realm, with the apisix/vista role.
VISTA_COLLAB_AUTH_MODE=oidc
# VISTA_COLLAB_OIDC_ISSUER=https://obsidian.ccs.ornl.gov/auth/realms/obsidian
# VISTA_COLLAB_OIDC_ALLOWED_AZP='["apisix"]'
# VISTA_COLLAB_OIDC_REQUIRED_ROLE=apisix/vista

# The gateway serves this server at https://obsidian.ccs.ornl.gov/vista/api and
# strips the prefix; this puts it back in the docs' links.
VISTA_COLLAB_ROOT_PATH=/vista/api

VISTA_COLLAB_DATA_DIR=/sw/holly/apps/vista/var/data
VISTA_COLLAB_SSL_CERTFILE=/sw/holly/apps/vista/var/tls/server.crt
VISTA_COLLAB_SSL_KEYFILE=/sw/holly/apps/vista/var/tls/server.key
# The data is on NFS, where SQLite's WAL does not work.
VISTA_COLLAB_SQLITE_JOURNAL_MODE=DELETE

# Holly reaches the internet through OLCF's proxy: uv's downloads, and the
# realm's signing keys from obsidian.ccs.ornl.gov.
https_proxy=http://proxy.ccs.ornl.gov:3128
http_proxy=http://proxy.ccs.ornl.gov:3128
no_proxy=localhost,127.0.0.1,0.0.0.0
