{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vistaguard/sciagentbench/instance.schema.json",
  "title": "SciAgentBench instance",
  "description": "Frozen v0.1 authoring schema for a SciAgentBench instance (VISTAGuard Phase 9).",
  "type": "object",
  "required": ["instance_id", "boundary", "template", "kind", "sessions", "success_criterion"],
  "additionalProperties": false,
  "properties": {
    "instance_id": {"type": "string", "minLength": 1},
    "boundary": {"type": "string", "minLength": 1, "description": "Boundary label, e.g. B1.1"},
    "template": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["attack", "benign"]},
    "memory_namespace": {"type": "string"},
    "description": {"type": "string"},
    "variation_axis": {"type": "string"},
    "references": {"type": "array", "items": {"type": "string"}},
    "success_criterion": {"$ref": "#/$defs/criterion"},
    "utility_criterion": {"$ref": "#/$defs/criterion"},
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/session"}
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["check"],
      "additionalProperties": false,
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "params": {"type": "object"},
        "judge_prompt": {"type": "string"}
      }
    },
    "session": {
      "type": "object",
      "required": ["session_id"],
      "additionalProperties": false,
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "turns": {"type": "array", "items": {"$ref": "#/$defs/turn"}}
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": {"type": "string"},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
      }
    },
    "action": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["prompt", "tool_call", "memory_write", "memory_read", "rag_retrieve", "response"]
        },
        "gate": {"type": ["string", "null"], "enum": ["G1", "G2", "G3", "G4", "G5", null]},
        "is_attack": {"type": "boolean"},
        "is_utility": {"type": "boolean"},
        "label": {"type": "string"},
        "payload": {"type": "object"},
        "capability": {"$ref": "#/$defs/capability"}
      }
    },
    "capability": {
      "type": "object",
      "required": ["value_id"],
      "additionalProperties": false,
      "properties": {
        "value_id": {"type": "string", "minLength": 1},
        "source": {"type": "string"},
        "dual_use": {"type": "string", "enum": ["none", "cyber", "chem", "bio", "nuclear"]},
        "taint": {"type": "boolean"}
      }
    }
  }
}
