{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "JobOutputBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::amsc-vista-job-output"
    },
    {
      "Sid": "JobOutputObjectReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::amsc-vista-job-output/*"
    }
  ]
}
