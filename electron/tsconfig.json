{
  // Type-checks the plain JavaScript sources against Electron's bundled types.
  // There is no build: Electron runs src/ as written (design W2).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src", "test", "scripts", "playwright.config.js"]
}
