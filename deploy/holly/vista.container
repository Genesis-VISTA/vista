# VISTA, headless, on Holly: a Quadlet file (podman >= 4.4). Installed in
# /etc/containers/systemd/, it becomes vista.service under rootful podman.
# Starting it starts beam first (vllm-beam.service); stopping beam stops it.
# No [Install] section: it starts only when asked, never at boot.
[Unit]
Description=VISTA (headless staging), backed by beam
Requires=vllm-beam.service
After=vllm-beam.service network-online.target

[Container]
Image=localhost/vista-server:latest
ContainerName=vista
# VISTA's own ports (UI 3000, MCP server 8000, backend 8001, fixed in launch.sh)
# stay in the container's namespace: on Holly, Grafana has 3000 and something
# scrapes 127.0.0.1:8000/metrics. pasta's -T forwards the container's
# 127.0.0.1:8100 to the host's, where beam listens.
Network=pasta:-T,8100
# The UI, on the host's loopback only (no login): tunnel to 127.0.0.1:3001.
PublishPort=127.0.0.1:3001:3000
# The code sandbox is a microsandbox MicroVM.
AddDevice=/dev/kvm
# :U gives the folder to the container's user (ubuntu).
Volume=/scratch/baumannsk/vista-holly/data:/data:U
EnvironmentFile=/scratch/baumannsk/vista-holly/vista.env

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
