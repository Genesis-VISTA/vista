# Copy to /scratch/baumannsk/vista-holly/vista.env (see README.md).

# Headless: Slack's tokens go in <data dir>/secrets, not an OS keychain.
VISTA_BACKEND_DEPLOYMENT=hosted

# Beam, served by vllm-beam.service. vLLM runs without --api-key, so any key works.
VISTA_BACKEND_MODEL=openai:beam
OPENAI_BASE_URL=http://127.0.0.1:8100/v1
OPENAI_API_KEY=unused

# The UI's port (next start reads PORT). Grafana has 3000 on Holly.
PORT=3001

# The RAG embedding model's download, kept on the data volume rather than in the
# container, which is removed on every stop.
HF_HOME=/data/hf

# Holly reaches the internet (Slack, S3M, IRI, Globus) through OLCF's proxy.
# Localhost must bypass it: VISTA's own services and beam are on 127.0.0.1.
https_proxy=http://proxy.ccs.ornl.gov:3128
http_proxy=http://proxy.ccs.ornl.gov:3128
no_proxy=localhost,127.0.0.1,0.0.0.0
HTTPS_PROXY=http://proxy.ccs.ornl.gov:3128
HTTP_PROXY=http://proxy.ccs.ornl.gov:3128
NO_PROXY=localhost,127.0.0.1,0.0.0.0
