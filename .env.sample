### LLM Configuration, any OpenAI Compatible API, or an Azure OpenAI endpoint ###

# OpenAI Compatible API (e.g. AmSC Inference API)
OPENAI_MODEL="claude-opus"
OPENAI_BASE_URL="https://api.i2-core.american-science-cloud.org/"
# Get the AmSC inference API key from https://api.i2-core.american-science-cloud.org
OPENAI_API_KEY="..."

# Azure OpenAI config (e.g. AAIMS gpt-5 deployment)
# OPENAI_MODEL=gpt-5
# OPENAI_API_KEY="..."
# OPENAI_API_STYLE=chat_completions
# OPENAI_AUTH_MODE=api_key
# OPENAI_CHAT_URL=https://aoai-eastus2-aaims.openai.azure.com/openai/deployments/gpt-5/chat/completions?api-version=2025-01-01-preview


### MCP Server Config ###

# For Odo, should be your ucams id
VISTA_MCP_HPC_SSH_USER="<your-ucams-id>"
VISTA_MCP_S3M_TOKEN="..."

# NERSC Perlmutter via IRI API (optional; enables cluster="perlmutter" routing).
# Get a Globus IRI token (expires ~48h):
#   python iri-api-get-globus-token-main/get_globus_token.py --print-token --facilities nersc
# Refresh with: python iri-api-get-globus-token-main/get_globus_token.py --refresh-only
# VISTA_MCP_NERSC_IRI_TOKEN="..."
# VISTA_MCP_NERSC_ACCOUNT="<your-nersc-project>"
# Absolute remote dir on Perlmutter for ALL vista state. Per-job source code,
# downloaded models, and per-session output all live as subdirs of this root:
#   $VISTA_MCP_NERSC_REMOTE_DIR/<job>/src       <- RUN_DIR_Perlmutter (scp here)
#   $VISTA_MCP_NERSC_REMOTE_DIR/<job>/model     <- FORGE_MODEL_Perlmutter (auto-download)
#   $VISTA_MCP_NERSC_REMOTE_DIR/<session>/out   <- logs + $VISTA_OUT
# VISTA_MCP_NERSC_REMOTE_DIR="/pscratch/sd/<u>/<your-user>/.vista"

# Agent iteration cap for the molten-salt chat mode (default 10). Bump when using
# the model-fine-tuning "watch mode" loop that polls get_hpc_job_status until
# the job exits. ~3 tool calls per poll at 45s intervals → 100 covers a 30-epoch run.
# VISTA_MAX_AGENT_ITERATIONS_MOLTEN_SALT=100

# Key for the AmSC Open Metadata Server.
# Same key as the AmSC inference API, get it from https://api.i2-core.american-science-cloud.org
# VISTA_MCP_OMD_API_KEY="..."

# VISTA_MCP_RAG_MODEL="google/embeddinggemma-300m"

# AgentHPC — High Entropy Alloy Design (MoNbTaW) simulation code directory on
# the HPC cluster. Required for the "High Entropy Alloy Design" tab. No default.
# VISTA_AGENTHPC_ALLOY_DIR="/lustre/orion/scratch/<user>/.../MoNbTaW"


### Frontend Config ###
MCP_BASE_URL=http://127.0.0.1:8000/mcp
