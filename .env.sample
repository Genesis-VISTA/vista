# "dev" or "prod"
VISTA_ENV=dev

### LLM Config ###

# This is passed to Pydantic AI, see https://pydantic.dev/docs/ai/api/pydantic-ai/providers/ for
# env vars to set for specific providers

# OpenAI Compatible API (e.g. AmSC Inference API)
VISTA_BACKEND_MODEL="openai:claude-sonnet"
OPENAI_BASE_URL="https://api.i2-core.american-science-cloud.org"
# Get the AmSC inference API key from https://api.i2-core.american-science-cloud.org
OPENAI_API_KEY="..."

# Azure OpenAI config (e.g. AAIMS gpt-5 deployment)
# VISTA_BACKEND_MODEL="azure:gpt-5"
# AZURE_OPENAI_ENDPOINT=https://aoai-eastus2-aaims.openai.azure.com
# OPENAI_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_API_KEY=...

### Backend Config ###
# VISTA_BACKEND_HOST="0.0.0.0"
# VISTA_BACKEND_PORT="8001"
# VISTA_MCP_URL="http://localhost:8000/mcp"

# Encryption key for secrets in the database. Optional for dev mode, required in prod mode
# VISTA_BACKEND_ENCRYPTION_KEY=

# Optional GitHub personal access token used when importing skills from
# private repos via `POST /skills/import` (i.e. the Import button on /skills).
# Public repos work without a token but are subject to 60 req/hr rate limits.
# VISTA_BACKEND_GITHUB_TOKEN="ghp_..."

### MCP Server Config ###
# For Odo (and Frontier), should be your ucams id. The SSH connection uses this
# user for SCP/sacct file operations on both clusters.
VISTA_MCP_HPC_SSH_USER="<your-ucams-id>"

# NOTE: S3M tokens are NOT read from this env file. They live on the per-user
# record (encrypted) and are set via the UI: User settings → S3M token. The
# same token enables both cluster="odo" and cluster="frontier" routing.

# Frontier (OLCF) via the AmSC IRI API (optional; enables cluster="frontier"
# routing). Reuses the user's S3M token from the UI — the same bearer that hits
# Odo's S3M endpoint also works against OLCF's moderate-enclave IRI service.
#
# IRI compute is used for submit/status/cancel. File operations (source upload,
# log fetch, output download, mkdir) go through Globus — see the Globus block
# below. The Vista server hosts its own Globus collection covering both
# VISTA_LOCAL_HPC_JOBS_DIR and VISTA_OUTPUT_DIR, and each user supplies a Globus
# refresh token via the UI for the OLCF DTN side.
#
# VISTA_MCP_OLCF_IRI_URL="https://amsc-moderate.s3m.olcf.ornl.gov"   # default
# VISTA_MCP_OLCF_MACHINE="frontier"                                  # default

# Globus file transfer for Frontier (required for cluster="frontier"). The Vista
# server must run Globus Connect Personal (or GCS) exposing local_hpc_jobs_dir
# AND output_dir under a single collection. Each user adds a Globus refresh
# token via UI: User settings → Globus token (mint with
# https://github.com/jqyin/OLCF-Globus-Transfer/blob/main/get_olcf_token.py).
#
# One-time perm setup on Frontier: `chmod 2775 <frontier_remote_dir>` once so that
# directories created by Globus inherit the setgid bit + group rwx, letting the
# IRI service's automation user (e.g. chm243_auser) traverse them.
#
# VISTA_MCP_VISTA_GLOBUS_COLLECTION_ID="<your-vista-server-gcs-uuid>"
# VISTA_MCP_OLCF_GLOBUS_COLLECTION_ID="36d521b3-c182-4071-b7d5-91db5d380d42"   # default = OLCF DTN GCS5

# NERSC Perlmutter via IRI API (optional; enables cluster="perlmutter" routing).
# Get a Globus IRI token (expires ~48h):
#   python iri-api-get-globus-token-main/get_globus_token.py --print-token --facilities nersc
# Refresh with: python iri-api-get-globus-token-main/get_globus_token.py --refresh-only
# VISTA_MCP_NERSC_IRI_TOKEN="..."
# VISTA_MCP_NERSC_ACCOUNT="<your-nersc-project>"
# Absolute remote dir on Perlmutter for ALL vista state. Per-job source code,
# downloaded models, and per-session output all live as subdirs of this root:
#   $VISTA_MCP_NERSC_REMOTE_DIR/<job>/src       <- RUN_DIR_Perlmutter (scp here)
#   $VISTA_MCP_NERSC_REMOTE_DIR/<job>/model     <- FORGE_MODEL_Perlmutter (auto-download)
#   $VISTA_MCP_NERSC_REMOTE_DIR/<session>/out   <- logs + $VISTA_OUT
# VISTA_MCP_NERSC_REMOTE_DIR="/pscratch/sd/<u>/<your-user>/.vista"

# Key for the AmSC Open Metadata Server.
# Same key as the AmSC inference API, get it from https://api.i2-core.american-science-cloud.org
# VISTA_MCP_OMD_API_KEY="..."

# VISTA_MCP_RAG_MODEL="google/embeddinggemma-300m"

# AgentHPC — High Entropy Alloy Design (MoNbTaW) simulation code directory on
# the HPC cluster. Required for the "High Entropy Alloy Design" tab. No default.
# VISTA_AGENTHPC_ALLOY_DIR="/lustre/orion/scratch/<user>/.../MoNbTaW"
