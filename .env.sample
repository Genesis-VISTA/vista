# "dev" or "prod"
VISTA_ENV=dev

### LLM Config ###

# This is passed to Pydantic AI, see https://pydantic.dev/docs/ai/api/pydantic-ai/providers/ for
# env vars to set for specific providers

# OpenAI Compatible API (e.g. AmSC Inference API)
VISTA_BACKEND_MODEL="openai:claude-sonnet"
OPENAI_BASE_URL="https://api.i2-core.american-science-cloud.org"
# Get the AmSC inference API key from https://api.i2-core.american-science-cloud.org
OPENAI_API_KEY="..."

# Azure OpenAI config (e.g. AAIMS gpt-5 deployment)
# VISTA_BACKEND_MODEL="azure:gpt-5"
# AZURE_OPENAI_ENDPOINT=https://aoai-eastus2-aaims.openai.azure.com
# OPENAI_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_API_KEY=...

### Backend Config ###
# VISTA_BACKEND_HOST="0.0.0.0"
# VISTA_BACKEND_PORT="8001"
# VISTA_MCP_URL="http://localhost:8000/mcp"

# Encryption key for secrets in the database. Optional for dev mode, required in prod mode
# VISTA_BACKEND_ENCRYPTION_KEY=

# Optional GitHub personal access token used when importing skills from
# private repos via `POST /skills/import` (i.e. the Import button on /skills).
# Public repos work without a token but are subject to 60 req/hr rate limits.
# VISTA_BACKEND_GITHUB_TOKEN="ghp_..."

# Optional GitLab personal access token, used to fetch private data. Needs Developer role and read_api and
# read_repository access. Generate at https://code.ornl.gov/v28/vista-data/-/settings/access_tokens
VISTA_DATA_TOKEN=

# Metrics / instrumentation (off by default = byte-identical no-op).
# One ordered level knob: off | prod (sampled production diagnostics) |
# perf (benchmarking: stage timing, sampling 1.0) | trace (incident debugging).
# Granular tri-state overrides (inherit|on|off): TOOL_TIMING, STAGE_TIMING,
# GATE_TIMING, AGENT_RUN, SKILL_USAGE. Events go to JSONL at
# {VISTA_DATA_DIR}/metrics/metrics.jsonl unless LOG_PATH is set.
# VISTA_BACKEND_METRICS__LEVEL="prod"
# VISTA_BACKEND_METRICS__SAMPLE_RATE="1.0"
# VISTA_BACKEND_METRICS__SKILL_USAGE="on"
# VISTA_BACKEND_METRICS__LOG_PATH="logs/metrics.jsonl"

### MCP Server Config ###
# Legacy SSH user (your ucams id). Only used by the optional agenthpc subserver
# (disabled by default) — the Odo/Frontier job tools no longer SSH.
# VISTA_MCP_HPC_SSH_USER="<your-ucams-id>"

# MCP server metrics (mirror of the backend knobs; off by default).
# VISTA_MCP_METRICS__LEVEL="perf"

# Experiment flags — for benchmarking ONLY. They change what the server *does*,
# so the startup guard refuses them when VISTA_ENV=prod. Never set in production.
#   HPC dry-run: synthetic submit/status, no real cluster contact.
# VISTA_MCP_HPC_DRY_RUN="true"
#   Synthetic queue wait for dry-run jobs, seconds (e.g. 300 / 3600 / 86400).
# VISTA_MCP_HPC_QUEUE_DELAY_S="300"
#   Fault injection for recovery testing: submit-fail / status-timeout
#   probabilities (0..1) and simulated token expiry after N seconds.
# VISTA_MCP_FAULT__SUBMIT_FAIL_P="0.1"
# VISTA_MCP_FAULT__STATUS_TIMEOUT_P="0.1"
# VISTA_MCP_FAULT__TOKEN_EXPIRE_AFTER_S="86400"

# Globus file transfer for Odo and Frontier
# Generate these with ./scripts/get_globus_token.py --cluster [odo/frontier] --save-env
VISTA_MCP_ODO_GLOBUS_REFRESH_TOKEN=
VISTA_MCP_FRONTIER_GLOBUS_REFRESH_TOKEN=
# Optional, only required for non-interactive launch in prod. Generate with:
#     uvx --from globus-cli globus gcp create mapped "vista-server"
# setup keys are single use; GCP's endpoint config is stored under $VISTA_DATA_DIR/globusonline so
# it persists across container restarts
# GLOBUS_SETUP_KEY=

# Key for the AmSC Open Metadata Server.
# Same key as the AmSC inference API, get it from https://api.i2-core.american-science-cloud.org
# VISTA_MCP_OMD_API_KEY="..."

# VISTA_MCP_RAG_MODEL="google/embeddinggemma-300m"

# AgentHPC — High Entropy Alloy Design (MoNbTaW) simulation code directory on
# the HPC cluster. Required for the "High Entropy Alloy Design" tab. No default.
# VISTA_AGENTHPC_ALLOY_DIR="/lustre/orion/scratch/<user>/.../MoNbTaW"

# For downloading the rag model
HF_TOKEN=
